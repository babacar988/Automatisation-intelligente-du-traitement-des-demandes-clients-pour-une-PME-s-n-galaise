    {
      "parameters": {
        "jsCode": "// ACTION URGENCE — Notification immédiate responsable\nconst d = $input.first().json;\nreturn [{ json: {\n  req_id:       d.req_id,\n  nom:          d.nom,\n  email:        d.email,\n  telephone:    d.telephone,\n  texte:        d.texte,\n  classe:       d.classe,\n  confiance:    d.confiance,\n  reponse_client: d.reponse_client,\n  label: '🚨 URGENCE',\n  sujet_email: '🚨 [URGENT] ' + d.req_id + ' — ' + d.nom,\n  corps_email: 'ALERTE URGENTE\\n\\nID : ' + d.req_id + '\\nClient : ' + d.nom + '\\nContact : ' + d.email + ' / ' + d.telephone + '\\n\\nMessage client :\\n\"' + d.texte + '\"\\n\\nConfiance ML : ' + d.confiance + '%\\n\\n⚡ INTERVENTION IMMÉDIATE REQUISE',\n  destinataire: 'bsarr@groupeisi.com',\n  reponse_finale: d.reponse_client\n}}];"
      },
      "id": "36e2fc26-ff50-4be3-8168-f305970257c4",
      "name": "🚨 Préparer Urgence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// ACTION RÉCLAMATION — Ticket + transfert service client\nconst d = $input.first().json;\nconst ticket = 'REC-' + Date.now();\nreturn [{ json: {\n  req_id:       d.req_id,\n  nom:          d.nom,\n  email:        d.email,\n  telephone:    d.telephone,\n  texte:        d.texte,\n  classe:       d.classe,\n  confiance:    d.confiance,\n  reponse_client: d.reponse_client,\n  label: '⚠️ RÉCLAMATION',\n  ticket: ticket,\n  sujet_email: '⚠️ [RÉCLAMATION] Ticket ' + ticket + ' — ' + d.nom,\n  corps_email: 'NOUVELLE RÉCLAMATION\\n\\nTicket : ' + ticket + '\\nID : ' + d.req_id + '\\nClient : ' + d.nom + '\\nContact : ' + d.email + ' / ' + d.telephone + '\\n\\nMessage client :\\n\"' + d.texte + '\"\\n\\nConfiance ML : ' + d.confiance + '%\\n\\n→ Traitement sous 24h requis',\n  destinataire: 'dieynasow92@gmail.com',\n  reponse_finale: d.reponse_client\n}}];"
      },
      "id": "f63b906d-90c8-4a74-878a-234f216b093e",
      "name": "⚠️ Préparer Réclamation",
