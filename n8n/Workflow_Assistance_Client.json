    {
      "parameters": {
        "jsCode": "// ACTION COMMANDE — Enregistrement + notification stock\nconst d = $input.first().json;\nconst cmd = 'CMD-' + Date.now();\nreturn [{ json: {\n  req_id:       d.req_id,\n  nom:          d.nom,\n  email:        d.email,\n  telephone:    d.telephone,\n  texte:        d.texte,\n  classe:       d.classe,\n  confiance:    d.confiance,\n  reponse_client: d.reponse_client,\n  label: '🛒 COMMANDE',\n  numero_cmd: cmd,\n  sujet_email: '🛒 [COMMANDE] ' + cmd + ' — ' + d.nom,\n  corps_email: 'NOUVELLE COMMANDE\\n\\nCommande : ' + cmd + '\\nID : ' + d.req_id + '\\nClient : ' + d.nom + '\\nContact : ' + d.email + ' / ' + d.telephone + '\\n\\nMessage client :\\n\"' + d.texte + '\"\\n\\nConfiance ML : ' + d.confiance + '%\\n\\n→ Confirmer disponibilité et délai de livraison',\n  destinataire: 'Mariemediop2200@gmail.com',\n  reponse_finale: d.reponse_client\n}}];"
      },
      "id": "dae7a812-559d-4eaa-b0b8-0b9fd98ae223",
      "name": "🛒 Préparer Commande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "// ACTION INFORMATION — Réponse automatique uniquement\nconst d = $input.first().json;\nreturn [{ json: {\n  req_id:       d.req_id,\n  nom:          d.nom,\n  email:        d.email,\n  telephone:    d.telephone,\n  texte:        d.texte,\n  classe:       d.classe,\n  confiance:    d.confiance,\n  reponse_client: d.reponse_client,\n  label: 'ℹ️ INFORMATION',\n  sujet_email: null,\n  corps_email: null,\n  destinataire: null,\n  reponse_finale: d.reponse_client\n}}];"
      },
      "id": "de192e49-5a1c-4ae4-85e5-ce6bb670833f",
      "name": "ℹ️ Préparer Information",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "// ✅ SOLUTION : lire les données depuis 📝 Fusionner Données (toujours disponible)\n// + le label depuis le nœud Préparer qui nous a envoyé l'input\nconst input = $input.first().json;\n\n// Données brutes du formulaire + ML (toujours disponibles via Fusionner)\nconst fusionner = $('📝 Fusionner Données').item.json;\n\n// Date/heure actuelles\nconst now = new Date();\nconst pad = (n) => String(n).padStart(2, '0');\nconst dateStr = pad(now.getDate()) + '/' + pad(now.getMonth()+1) + '/' + now.getFullYear();\nconst timeStr = pad(now.getHours()) + ':' + pad(now.getMinutes());\n\n// Échappement CSV\nconst esc = (v) => {\n  const s = String(v ?? '').replace(/\"/g, '\"\"');\n  return (s.includes(',') || s.includes('\"') || s.includes('\\n')) ? `\"${s}\"` : s;\n};\n\n// label : disponible dans input (nœud Préparer) ou fallback sur classe\nconst label = input.label ?? fusionner.classe ?? '';\n\nconst headers = 'ID;Date;Heure;Nom;Email;Téléphone;Classe ML;Confiance (%);Message;Action;Statut';\nconst row = [\n  fusionner.req_id      ?? '',\n  dateStr,\n  timeStr,\n  fusionner.nom         ?? '',\n  fusionner.email       ?? '',\n  fusionner.telephone   ?? '',\n  fusionner.classe      ?? '',\n  fusionner.confiance   ?? '',\n  fusionner.texte       ?? '',\n  label,\n  'Traité'\n].map(esc).join(';');\n\nconst csvContent = '\\uFEFF' + headers + '\\n' + row + '\\n';\n\nconst binaryData = await this.helpers.prepareBinaryData(\n  Buffer.from(csvContent, 'utf8'),\n  'historique_demandes.csv',\n  'text/csv'\n);\n\nreturn [{\n  json: { success: true, req_id: fusionner.req_id },\n  binary: { data: binaryData }\n}];\n"
      },
